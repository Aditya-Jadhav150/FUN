---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="We're Currently Not Showing Anything"
  description="We are currently preparing something new. Please check back soon."
>
  <div class="relative w-full min-h-[100dvh] flex flex-col items-center justify-center text-center p-6 select-none overflow-hidden">
    <!-- Ambient Glowing Background Aura -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full blur-[140px] bg-sky-500/20 pointer-events-none animate-ambient-pulse"></div>
    <div class="absolute top-1/3 right-1/4 w-[350px] h-[350px] rounded-full blur-[120px] bg-rose-500/15 pointer-events-none"></div>

    <div class="relative z-10 max-w-lg w-full glass-panel-cyan p-10 sm:p-14 rounded-3xl border border-sky-400/30 shadow-[0_20px_60px_rgba(8,4,14,0.8)] flex flex-col items-center">
      <!-- Animated Pulsing Icon -->
      <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-sky-400 via-cyan-300 to-rose-400 p-0.5 mb-8 shadow-[0_0_35px_rgba(56,189,248,0.5)] animate-bounce">
        <div class="w-full h-full rounded-full bg-[#08040e] flex items-center justify-center text-3xl">
          ✨
        </div>
      </div>

      <!-- Main Animated Message -->
      <h1 class="text-3xl sm:text-5xl font-serif italic text-cyan-gradient mb-4 leading-tight">
        We're Currently Not Showing Anything
      </h1>

      <p class="text-slate-300 font-light text-sm sm:text-base leading-relaxed mb-8 max-w-sm">
        Something new is being crafted behind the scenes. Please check back later.
      </p>

      <!-- Animated Status Indicator -->
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full glass-panel border border-sky-400/30 text-xs font-mono text-sky-200">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-ping"></span>
        <span>Offline / Maintenance Mode</span>
      </div>
    </div>
  </div>
</BaseLayout>
