---
---

<section class="relative py-20 lg:py-32 flex flex-col items-center text-center overflow-hidden">
  <!-- Radial Light Leaks -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full blur-[140px] bg-sky-500/20 pointer-events-none animate-ambient-pulse"></div>
  <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] rounded-full blur-[120px] bg-rose-500/15 pointer-events-none"></div>

  <!-- Tech Badge -->
  <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-panel-cyan border border-sky-400/30 text-xs font-mono text-sky-200 mb-8 shadow-lg">
    <span class="text-rose-400">⚡</span> Powered by Astro 5 + Tailwind CSS v4
  </div>

  <!-- Main Heading -->
  <h1 class="text-5xl sm:text-6xl lg:text-7xl font-serif italic tracking-tight max-w-4xl text-cyan-gradient leading-none mb-6">
    Next-Gen Web Performance & Design Excellence
  </h1>

  <!-- Subtitle -->
  <p class="text-lg sm:text-xl text-slate-300 max-w-2xl font-light leading-relaxed mb-10">
    Built from the ground up using Astro Islands Architecture, Tailwind CSS v4 design tokens, and strict Web Interface Guidelines compliance.
  </p>

  <!-- CTA Buttons -->
  <div class="flex flex-wrap items-center justify-center gap-4 z-10">
    <a href="#features" class="px-8 py-4 rounded-full font-medium text-slate-950 bg-gradient-to-r from-sky-400 to-cyan-300 hover:from-sky-300 hover:to-cyan-200 shadow-[0_0_30px_rgba(56,189,248,0.5)] transition-all focus-visible:ring-2 focus-visible:ring-sky-400 flex items-center gap-2">
      <span>Explore Features</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l7-7m7 7H3" />
      </svg>
    </a>

    <a href="#skills" class="px-8 py-4 rounded-full font-medium text-white glass-panel hover:bg-white/10 transition-colors border border-white/20 focus-visible:ring-2 focus-visible:ring-sky-400">
      View Installed Skills
    </a>
  </div>

  <!-- Feature Pill Highlights -->
  <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 w-full max-w-3xl">
    <div class="p-4 rounded-2xl glass-panel text-center">
      <div class="text-2xl font-bold font-mono text-sky-400">100</div>
      <div class="text-xs text-slate-400 uppercase tracking-widest mt-1">Lighthouse Score</div>
    </div>
    <div class="p-4 rounded-2xl glass-panel text-center">
      <div class="text-2xl font-bold font-mono text-rose-400">0 KB</div>
      <div class="text-xs text-slate-400 uppercase tracking-widest mt-1">Default JS</div>
    </div>
    <div class="p-4 rounded-2xl glass-panel text-center">
      <div class="text-2xl font-bold font-mono text-amber-300">v4.0</div>
      <div class="text-xs text-slate-400 uppercase tracking-widest mt-1">Tailwind CSS</div>
    </div>
    <div class="p-4 rounded-2xl glass-panel text-center">
      <div class="text-2xl font-bold font-mono text-emerald-400">100%</div>
      <div class="text-xs text-slate-400 uppercase tracking-widest mt-1">Accessible</div>
    </div>
  </div>
</section>
