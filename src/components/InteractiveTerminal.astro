---
const SKILLS = [
  {
    name: 'astro',
    status: 'ACTIVE',
    version: 'v0.0.1',
    description: 'Astro Web Framework skill for building content-driven SSG/SSR sites, content collections, and islands architecture.',
    commands: ['npx astro dev', 'npx astro build', 'npx astro check', 'npx astro add vercel']
  },
  {
    name: 'tailwind-4-docs',
    status: 'ACTIVE',
    version: 'v4.0.0',
    description: 'Tailwind CSS v4 documentation snapshot skill for configuring utility styles, theme tokens, and custom CSS variables.',
    commands: ['@import "tailwindcss";', '@theme { --font-sans: Outfit; }', 'focus-visible:ring-2']
  },
  {
    name: 'web-design-guidelines',
    status: 'ACTIVE',
    version: 'v1.0.0',
    description: 'Vercel Web Interface Guidelines skill for enforcing accessibility, semantic HTML, focus states, and performance compliance.',
    commands: ['<main id="main-content">', 'aria-label="Action"', 'focus-visible:ring-sky-400', 'prefers-reduced-motion']
  }
];
---

<section id="skills" class="py-20 border-t border-white/10">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span class="text-xs uppercase tracking-widest text-emerald-400 font-mono">Agent Environment</span>
    <h2 class="text-4xl sm:text-5xl font-serif italic text-gold-gradient mt-2 mb-4">
      Active Agent Skills Status
    </h2>
    <p class="text-slate-300 font-light text-base sm:text-lg">
      Inspect the agent skills configured in <code class="text-sky-300 font-mono text-sm bg-white/5 px-2 py-0.5 rounded">.agents/skills/</code>.
    </p>
  </div>

  <div id="terminal" class="max-w-4xl mx-auto rounded-3xl glass-panel border border-white/20 shadow-2xl overflow-hidden">
    <!-- Terminal Header Bar -->
    <div class="bg-slate-950/90 px-6 py-4 border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
        <span class="text-xs font-mono text-slate-400 ml-3">antigravity@agent-skills:~</span>
      </div>
      <span class="text-xs font-mono text-emerald-400 bg-emerald-950/60 px-2.5 py-1 rounded-full border border-emerald-500/30">
        ● 3 Skills Loaded
      </span>
    </div>

    <!-- Skill Grid -->
    <div class="p-6 sm:p-8 space-y-6">
      {SKILLS.map((skill) => (
        <div class="p-6 rounded-2xl bg-slate-950/60 border border-white/10 hover:border-sky-400/30 transition-colors">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-3">
            <div class="flex items-center gap-3">
              <span class="text-xl font-mono font-bold text-sky-400">{skill.name}</span>
              <span class="px-2.5 py-0.5 rounded-md text-[10px] font-mono bg-emerald-500/10 text-emerald-300 border border-emerald-400/30">
                {skill.status}
              </span>
            </div>
            <span class="text-xs font-mono text-slate-400">{skill.version}</span>
          </div>

          <p class="text-slate-300 text-sm font-light leading-relaxed mb-4">
            {skill.description}
          </p>

          <div class="bg-slate-900/90 p-3 rounded-xl border border-white/5 font-mono text-xs text-slate-300 flex flex-wrap gap-2">
            {skill.commands.map((cmd) => (
              <span class="bg-white/5 px-2.5 py-1 rounded text-sky-300 border border-white/5">
                $ {cmd}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
