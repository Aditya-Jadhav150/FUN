---
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#08040e]/80 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus-visible:ring-2 focus-visible:ring-sky-400 rounded-lg p-1">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-400 via-rose-400 to-amber-300 flex items-center justify-center text-slate-950 font-bold text-lg shadow-[0_0_20px_rgba(56,189,248,0.4)] group-hover:scale-105 transition-transform">
        A
      </div>
      <span class="font-serif italic text-xl font-bold text-cyan-gradient tracking-tight">
        Astro<span class="text-sky-400 text-sm font-sans not-italic font-mono ml-1">v5</span>
      </span>
    </a>

    <!-- Navigation Links -->
    <nav aria-label="Main Navigation" class="flex items-center gap-1 sm:gap-6">
      <a href="#features" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-white/5 transition-colors focus-visible:ring-2 focus-visible:ring-sky-400">
        Features
      </a>
      <a href="#skills" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-white/5 transition-colors focus-visible:ring-2 focus-visible:ring-sky-400">
        Agent Skills
      </a>
      <a href="#terminal" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-white/5 transition-colors focus-visible:ring-2 focus-visible:ring-sky-400">
        Terminal
      </a>
    </nav>

    <!-- Status Pill -->
    <div class="hidden md:flex items-center gap-2 px-3 py-1 rounded-full glass-panel-cyan border border-sky-400/30 text-xs text-sky-200">
      <span class="w-2 h-2 rounded-full bg-sky-400 animate-ping"></span>
      <span class="font-mono">Astro 5 SSG Ready</span>
    </div>
  </div>
</header>
